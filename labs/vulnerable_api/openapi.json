{
  "openapi": "3.1.0",
  "info": {
    "title": "BreachBench Lab API (Vulnerable vs. Hardened)",
    "description": "Self-contained lab API with 10 vulnerable routes (/vuln/*) and 10 hardened counterparts (/hardened/*).",
    "version": "1.0.0"
  },
  "paths": {
    "/vuln/notes/{note_id}": {
      "get": {
        "tags": [
          "Vulnerable"
        ],
        "summary": "Vuln Get Note",
        "description": "VULNERABLE (API1:2023 BOLA/IDOR): Returns any note by ID without checking caller's account scope.",
        "operationId": "vuln_get_note_vuln_notes__note_id__get",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/hardened/notes/{note_id}": {
      "get": {
        "tags": [
          "Hardened"
        ],
        "summary": "Hardened Get Note",
        "description": "HARDENED (API1:2023): Enforces per-account ownership before returning note.",
        "operationId": "hardened_get_note_hardened_notes__note_id__get",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Note Id"
            }
          },
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Account-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
